<Project>
  <!-- Strip all proprietary BASS native binaries copied transitively by ppy.osu.Framework.NativeLibs (FFmpeg stays intact). -->
  <Target Name="StripProprietaryBassNativeLibs" AfterTargets="ResolvePackageAssets;ResolveLockFileCopyLocalFiles;ComputeFilesToPublish">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').ToLowerInvariant().Contains('bass'))" />
    </ItemGroup>
  </Target>
</Project>
